{
  "OpenTelemetry": {
    "ExportarOtlp": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Puerto": 55672,
    "VirtualHost": "/",
    "Usuario": "ultimamilla"
  },
  "Webhooks": {
    "Timeout": "00:00:05",
    "PermitirDestinosPrivados": false
  },
  "CierreOperativo": {
    "Intervalo": "00:05:00",
    "MaximoDiasPorOperador": 31
  },
  "PublicacionOutbox": {
    "Intervalo": "00:00:02",
    "MaximoMensajesPorLote": 100,
    "OperadoresEnParalelo": 4
  }
