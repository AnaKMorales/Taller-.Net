@page "/portal"
@model UltimaMilla.Web.Pages.Portal.IndexModel
@{
    ViewData["Title"] = "Mis envíos";
    ViewData["Seccion"] = "portal";
    Layout = "_Layout";
}

<h1>Mis envíos</h1>
<p class="nota">Envíos de tu comercio con este operador. El código de seguimiento es el que se le pasa al destinatario.</p>

<table>
    <thead>
        <tr><th>Código de seguimiento</th><th>Destinatario</th><th>Estado</th><th>Fecha de admisión</th></tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Envios)
        {
            <tr>
                <td><code>@e.CodigoSeguimiento</code></td>
                <td>@e.Destinatario</td>
                <td>@Textos.Estado(e.Estado)</td>
                <td>@Textos.Fecha(e.FechaAdmision)</td>
            </tr>
        }
        @if (Model.Envios.Count == 0)
        {
            <tr><td colspan="4" class="vacio">Todavía no hay envíos.</td></tr>
        }
    </tbody>
</table>
