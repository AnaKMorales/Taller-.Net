@page
@model UltimaMilla.Web.Pages.Envios.IndexModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Backoffice - Envíos</title>
</head>
<body>
    <h1>Envíos</h1>

    <p><a href="/envios/nuevo">Nuevo envío</a></p>

    @if (Model.Envios.Count == 0)
    {
        <p>No hay envíos cargados.</p>
    }
    else
    {
        <table border="1" cellpadding="5">
            <tr>
                <th>Código</th>
                <th>Destinatario</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Estado</th>
                <th>Fecha de admisión</th>
            </tr>
            @foreach (var envio in Model.Envios)
            {
                <tr>
                    <td>@envio.CodigoSeguimiento</td>
                    <td>@envio.DestinatarioNombre</td>
                    <td>@envio.DestinatarioTelefono</td>
                    <td>@envio.DireccionCalle</td>
                    <td>@envio.Estado</td>
                    <td>@envio.FechaAdmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </table>
    }
</body>
</html>
