<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Backoffice UltimaMilla</title>
    <link rel="stylesheet" href="/css/sitio.css" />
</head>
<body>
    <header>
        <strong>UltimaMilla</strong>
        @if (UltimaMilla.Web.Seguridad.Politicas.RolesBackoffice.Any(User.IsInRole))
        {
            <a href="/backoffice/tablero" class="@(ViewData["Seccion"] as string == "tablero" ? "activo" : "")">Tablero</a>
            <a href="/backoffice/incidencias" class="@(ViewData["Seccion"] as string == "incidencias" ? "activo" : "")">Incidencias</a>
            <a href="/backoffice/fallidos" class="@(ViewData["Seccion"] as string == "fallidos" ? "activo" : "")">Avisos fallidos</a>
        }
        @if (User.IsInRole("Administrador"))
        {
            <a href="/backoffice/reportes" class="@(ViewData["Seccion"] as string == "reportes" ? "activo" : "")">Reportes</a>
            <a href="/backoffice/configuracion/tarifas" class="@(ViewData["Seccion"] as string == "tarifas" ? "activo" : "")">Tarifas</a>
            <a href="/backoffice/configuracion/reglas" class="@(ViewData["Seccion"] as string == "reglas" ? "activo" : "")">Reglas</a>
        }
        @if (User.IsInRole("Comercio"))
        {
            <a href="/portal" class="@(ViewData["Seccion"] as string == "portal" ? "activo" : "")">Mis envíos</a>
            <a href="/portal/avisos" class="@(ViewData["Seccion"] as string == "avisos" ? "activo" : "")">Avisos</a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="usuario">
                @User.Identity.Name
                <form method="post" asp-page="/Login" asp-page-handler="Salir"><button type="submit">Salir</button></form>
            </span>
        }
    </header>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
