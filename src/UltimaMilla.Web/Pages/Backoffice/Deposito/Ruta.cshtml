@page "/backoffice/deposito/rutas/{id:guid}"
@model UltimaMilla.Web.Pages.Backoffice.Deposito.RutaModel
@{
    var r = Model.Ruta!;
    ViewData["Title"] = "Carga de ruta";
    ViewData["Seccion"] = "deposito";
    Layout = "_Layout";
    var despachada = r.DespachadaEn is not null;
}

<p><a href="/backoffice/deposito">← Depósito y rutas</a></p>
<h1>Ruta @(Model.Datos is { } d ? $"de {d.Repartidor} · {d.Matricula}" : "")</h1>
<p>Cargados <strong>@r.Cargados de @r.Esperados</strong> bultos@(despachada ? " · ya despachada" : "")</p>
@if (Model.Exito is not null) { <p class="exito">@Model.Exito</p> }
@if (Model.Error is not null) { <p class="error">@Model.Error</p> }

@if (!despachada)
{
    <form method="post" asp-page-handler="Cargar" class="formulario">
        <input type="hidden" name="Version" value="@r.Version" />
        <label>Código del bulto <input name="Codigo" autofocus autocomplete="off" required /></label>
        <div><button type="submit">Registrar carga</button></div>
    </form>
}

<table>
    <thead><tr><th>Bulto</th><th>Cargado</th></tr></thead>
    <tbody>
        @foreach (var b in r.Bultos)
        {
            <tr><td><code>@b.Codigo</code></td><td>@(b.Cargado ? "✓" : "—")</td></tr>
        }
        @if (r.Bultos.Count == 0) { <tr><td colspan="2" class="vacio">La ruta todavía no tiene envíos asignados.</td></tr> }
    </tbody>
</table>

@if (!despachada && Model.PuedeDespachar)
{
    <form method="post" asp-page-handler="Despachar">
        <input type="hidden" name="Version" value="@r.Version" />
        @if (r.Faltantes > 0) { <p class="nota">Faltan cargar @r.Faltantes bultos.</p> }
        <button type="submit">Despachar ruta</button>
    </form>
}
