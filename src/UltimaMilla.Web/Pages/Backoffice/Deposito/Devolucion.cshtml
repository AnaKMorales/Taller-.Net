@page "/backoffice/deposito/devolucion/{id:guid}"
@model UltimaMilla.Web.Pages.Backoffice.Deposito.DevolucionModel
@using UltimaMilla.Domain.Deposito
@using UltimaMilla.Web.Compartido
@{ var e = Model.Envio!; ViewData["Title"] = "Devolución"; ViewData["Seccion"] = "deposito"; Layout = "_Layout"; }
<p><a href="/backoffice/deposito/cierre">← Devoluciones y rendición</a> · <a href="/backoffice/envios/@e.EnvioId">Detalle del envío</a></p>
<h1>Devolución de <code>@e.CodigoSeguimiento</code></h1>
<p>Estado del envío: @Textos.Estado(e.Estado)</p>
@if (Model.Exito is not null) { <p class="exito">@Model.Exito</p> }
@if (Model.Error is not null) { <p class="error">@Model.Error</p> }
@if (e.Devolucion is not { } d)
{
    <p>No tiene una devolución registrada. El inicio se valida según las reglas y el estado del envío.</p>
    <form method="post" asp-page-handler="Iniciar"><input type="hidden" name="Version" value="@e.Version" /><button type="submit">Iniciar devolución según las reglas</button></form>
}
else
{
    <p>Devolución: @(d.Estado == EstadoDevolucion.EnProceso ? "En proceso" : "Completada") · Inicio: @Textos.Fecha(d.FechaInicio) · Plazo: @Textos.Fecha(d.PlazoLimite)</p>
    <p>Recibidos <strong>@d.Recibidos de @d.Esperados</strong>. Faltan @d.Faltantes.</p>
    @if (d.FechaCierre is { } cierre) { <p>Completada: @Textos.Fecha(cierre)</p> }
    <table><thead><tr><th>Bulto esperado</th><th>Estado</th><th>Recibido</th></tr></thead><tbody>
    @foreach (var b in d.Bultos) { <tr><td><code>@b.Codigo</code></td><td>@Textos.Bulto(b.Estado)</td><td>@(b.Recibido ? "Sí" : "No")</td></tr> }
    </tbody></table>
    @if (d.Estado == EstadoDevolucion.EnProceso)
    {
        <form method="post" asp-page-handler="Escanear" class="formulario">
            <input type="hidden" name="Version" value="@e.Version" />
            <label>Código del bulto <input name="Codigo" autofocus autocomplete="off" required /></label>
            <button type="submit">Recibir bulto devuelto</button>
        </form>
        @if (d.Faltantes == 0)
        {
            <form method="post" asp-page-handler="Completar"><input type="hidden" name="Version" value="@e.Version" /><p>Confirmá que recibiste todos los bultos indicados.</p><button type="submit">Confirmar devolución completa</button></form>
        }
    }
}
