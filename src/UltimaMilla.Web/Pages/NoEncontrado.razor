@page "/no-encontrado"
@* Página 404 de Blazor (Router.NotFoundPage). Mismo texto para cualquier token inválido. *@

<PageTitle>No encontrado</PageTitle>
<HeadContent>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #1d2530; background: #f5f7f9; }
        main { max-width: 640px; margin: 0 auto; padding: 24px 16px; }
        .tarjeta { background: #fff; border: 1px solid #dfe4ea; border-radius: 12px; padding: 20px; }
        .titulo { font-size: 1.4rem; font-weight: 700; margin: 0 0 6px; }
        .detalle { margin: 0; color: #5b6675; }
    </style>
</HeadContent>

<main>
    <div class="tarjeta">
        <p class="titulo">No encontramos el envío</p>
        <p class="detalle">Revisá que el enlace esté completo, tal como lo recibiste por correo o mensaje.</p>
    </div>
</main>
