@page "/envios/nuevo"
@rendermode InteractiveServer
@inject CrearEnvioHandler Handler

<h1>Nuevo envío</h1>

<EditForm Model="comando" OnSubmit="Guardar">
    <p>
        <label>Nombre del destinatario</label><br />
        <InputText @bind-Value="comando.DestinatarioNombre" />
    </p>
    <p>
        <label>Teléfono</label><br />
        <InputText @bind-Value="comando.DestinatarioTelefono" />
    </p>
    <p>
        <label>Dirección</label><br />
        <InputText @bind-Value="comando.DireccionCalle" />
    </p>
    <button type="submit">Crear envío</button>
</EditForm>

@if (error != null)
{
    <p style="color:red">@error</p>
}

@if (codigo != null)
{
    <p>Envío creado. Código de seguimiento: <b>@codigo</b></p>
}

<p><a href="/envios">Ver listado de envíos</a></p>

@code {
    private CrearEnvioCommand comando = new();
    private string? codigo;
    private string? error;

    private async Task Guardar()
    {
        error = null;
        codigo = null;

        if (string.IsNullOrWhiteSpace(comando.DestinatarioNombre) || string.IsNullOrWhiteSpace(comando.DireccionCalle))
        {
            error = "El nombre y la dirección son obligatorios";
            return;
        }

        try
        {
            var envio = await Handler.Handle(comando);
            codigo = envio.CodigoSeguimiento;
            comando = new CrearEnvioCommand();
        }
        catch (ArgumentException)
        {
            error = "Completa los datos del envío, sus bultos y la programación antes de guardar.";
        }
        catch (UltimaMilla.Application.Abstractions.AislamientoOperadorException)
        {
            error = "No se pudo validar el acceso para crear el envío.";
        }
    }
}
