@page "/pendientes"
@implements IDisposable
@inject ColaAcciones Cola
@inject DatosLocales Datos
@inject EstadoConexion Conexion
@inject SincronizacionAutomatica Automatica
@inject ApiRepartidorFalsa ServidorDePrueba
@inject NavigationManager Navegacion

<PageTitle>Sincronización</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 mb-0">Sincronización</h1>
    <button class="btn btn-sm btn-primary" @onclick="SincronizarAsync" disabled="@(_sesion is null || !Conexion.EnLinea || _procesando)">Sincronizar ahora</button>
</div>

@if (_cola.Count == 0)
{
    <p>No hay acciones registradas.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var item in _cola.OrderByDescending(a => a.Accion.OcurridoEn))
        {
            <li class="list-group-item small">
                <div class="d-flex justify-content-between">
                    <strong>@Destinatario(item.Accion.EnvioId) · @item.Accion.ResultadoVisible</strong>
                    <span class="badge @Color(item.Estado)">@item.Estado</span>
                </div>
                <div class="text-muted">
                    @item.Accion.OcurridoEn.ToLocalTime().ToString("HH:mm:ss") · operación @item.Accion.IdOperacion.ToString()[..8]
                    @(item.Accion.Posicion is null ? " · sin GPS" : " · con GPS")
                    @(item.Intentos > 0 ? $" · {item.Intentos} reintento(s)" : "")
                </div>
                @if (item.Detalle is not null)
                {
                    <div>@item.Detalle</div>
                }
                @if (item.Estado == EstadoAccion.Rechazada)
                {
                    @if (item.Conflicto is { } conflicto)
                    {
                        <div class="alert alert-warning mt-2 mb-2">
                            <strong>La visita no se guardó.</strong>
                            <p>@(conflicto.ParadaActiva ? "La parada sigue activa, pero el envío cambió." : "La parada ya está cerrada.")</p>
                            <table class="table table-sm"><thead><tr><th>Bulto</th><th>Estado en el servidor</th><th>Motivo</th></tr></thead><tbody>
                            @foreach (var b in conflicto.Bultos)
                            {
                                <tr><td>@(b.Codigo ?? "Bulto sin identificar")</td><td>@EstadoBultoVisible(b.EstadoActual)</td><td>@MotivoVisible(b.Motivo)</td></tr>
                            }
                            </tbody></table>
                            <p>Se conservan tu visita y sus evidencias. Revisá la hoja actualizada antes de registrar otra visita; esta acción no se reenviará automáticamente.</p>
                            <a href="">Ir a la hoja para actualizarla</a>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-danger mt-1" @onclick="() => DescartarAsync(item.Accion.IdOperacion)">Entendido, descartar</button>
                }
            </li>
        }
    </ul>
}

@if (EsDemo)
{
<div class="card border-info">
    <div class="card-body small">
        <h2 class="h6">Servidor de prueba</h2>
        <p class="mb-2">Intentos registrados: <strong>@_registradas</strong> · reenvíos descartados por IdOperacion: <strong>@_duplicadas</strong></p>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-outline-info" @onclick="ReenviarSincronizadasAsync" disabled="@(!Conexion.EnLinea || _procesando)">Reenviar sincronizadas (probar duplicados)</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReiniciarAsync">Reiniciar datos de prueba</button>
        </div>
    </div>
</div>
}

@code {
    private static string MotivoVisible(string motivo) => motivo switch
    {
        "EstadoCambio" => "El estado del bulto cambió",
        "ParadaCerrada" => "La parada ya está cerrada",
        "FueraDeParada" => "El bulto no pertenece a esta parada",
        "SinCambioDeEstado" => "El envío cambió, aunque este bulto conserva su estado",
        _ => "Revisá el estado actual en la hoja"
    };
    private static string EstadoBultoVisible(string? estado) => estado switch
    {
        "EnDeposito" => "En depósito", "AsignadoARuta" => "Asignado a ruta", "EnTransito" => "En tránsito",
        "NoEntregado" => "No entregado", "EnDevolucion" => "En devolución", null => "No disponible",
        _ => estado
    };
    private IReadOnlyList<AccionPendiente> _cola = [];
    private HojaDeRutaDto? _hoja;
    private SesionRepartidor? _sesion;
    private bool EsDemo => _hoja is { VersionRuta: null, RutasDisponibles: null } && _sesion is not null;
    private int _registradas;
    private int _duplicadas;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        Cola.Cambio += AlCambiar;
        Conexion.Cambio += AlCambiar;
        Datos.HojaActualizada += AlCambiar;
        Datos.SesionActualizada += AlCambiar;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _sesion = await Datos.ObtenerSesionAsync();
        _cola = _sesion is null ? [] : await Cola.ListarAsync(_sesion.RepartidorId);
        _hoja = await Datos.ObtenerHojaAsync();
        (_registradas, _duplicadas) = await ServidorDePrueba.ResumenAsync();
    }

    private void AlCambiar() => _ = InvokeAsync(async () =>
    {
        await CargarAsync();
        StateHasChanged();
    });

    private string Destinatario(Guid envioId) =>
        _hoja?.Paradas.SingleOrDefault(p => p.EnvioId == envioId)?.Destinatario ?? "Envío";

    private static string Color(EstadoAccion estado) => estado switch
    {
        EstadoAccion.Pendiente => "bg-warning text-dark",
        EstadoAccion.Sincronizada => "bg-success",
        _ => "bg-danger"
    };

    private async Task SincronizarAsync()
    {
        _procesando = true;
        await Automatica.SincronizarAhoraAsync();
        await CargarAsync();
        _procesando = false;
    }

    private Task DescartarAsync(Guid idOperacion) => _sesion is { } sesion
        ? Cola.DescartarRechazadaAsync(idOperacion, sesion.RepartidorId)
        : Task.CompletedTask;

    // Simula que la respuesta del servidor se perdió y la app vuelve a mandar lo mismo:
    // el contador de registrados no debe subir, solo el de descartados.
    private async Task ReenviarSincronizadasAsync()
    {
        _procesando = true;
        try
        {
            foreach (var item in _cola.Where(a => a.Estado == EstadoAccion.Sincronizada && a.Accion.Intento is null))
                await ServidorDePrueba.EnviarAccionAsync(item.Accion);
        }
        catch (HttpRequestException)
        {
            // Se cortó la red durante la prueba: no cambia nada en la cola.
        }
        finally
        {
            await CargarAsync();
            _procesando = false;
        }
    }

    private async Task ReiniciarAsync()
    {
        if (!EsDemo || _sesion is not { } sesion) return;
        await Cola.VaciarDemoAsync(sesion.RepartidorId);
        await ServidorDePrueba.ReiniciarAsync();
        await Datos.CerrarSesionAsync();
        Navegacion.NavigateTo("login", forceLoad: true);
    }

    public void Dispose()
    {
        Cola.Cambio -= AlCambiar;
        Conexion.Cambio -= AlCambiar;
        Datos.HojaActualizada -= AlCambiar;
        Datos.SesionActualizada -= AlCambiar;
    }
}
