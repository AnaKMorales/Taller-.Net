@page "/"
@implements IDisposable
@inject DatosLocales Datos
@inject ColaAcciones Cola
@inject IApiRepartidor Api
@inject EstadoConexion Conexion
@inject NavigationManager Navegacion
@inject TimeProvider Reloj

<PageTitle>Hoja de ruta</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="h4 mb-0">Hoja de ruta</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" @onclick="ActualizarAsync" disabled="@(!Conexion.EnLinea || _procesando)">Actualizar</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="SalirAsync">Salir</button>
    </div>
</div>

@if (_sesion is not null)
{
    <p class="small"><a href="seguridad">Seguridad de mi cuenta</a></p>
}

@if (_mensaje is not null)
{
    <div class="alert alert-warning py-2">@_mensaje</div>
}
@if (_sesion?.Vencida(Reloj.GetUtcNow()) == true)
{
    <div class="alert alert-warning py-2">
        Tu sesión venció. Lo que registres se guarda en el teléfono; <a href="login">ingresá de nuevo</a> para sincronizar.
    </div>
}

@if (_hoja is null)
{
    <p>No hay una hoja de ruta guardada. Conectate y tocá <strong>Actualizar</strong>.</p>
}
else if (_hoja.RutaId == Guid.Empty)
{
    <p>No tenés rutas despachadas disponibles.</p>
}
else
{
    @if (_hoja.RutasDisponibles is { Count: > 1 } rutas)
    {
        <label class="form-label" for="ruta-seleccionada">Ruta despachada</label>
        <select id="ruta-seleccionada" class="form-select mb-2" disabled="@(!Conexion.EnLinea || _procesando)"
                @bind:get="_hoja.RutaId" @bind:set="CambiarRutaAsync">
            @foreach (var ruta in rutas)
            {
                <option value="@ruta.RutaId">@ruta.Matricula · @ruta.DespachadaEn.ToLocalTime().ToString("dd/MM HH:mm") · @ruta.ParadasPendientes pendientes</option>
            }
        </select>
    }
    <p class="text-muted small">@_sesion?.Email · descargada @_hoja.DescargadaEn.ToLocalTime().ToString("dd/MM HH:mm")</p>
    @if (_hoja.Paradas.Count == 0)
    {
        <p>Esta ruta no tiene paradas pendientes.</p>
    }
    <ul class="list-group">
        @foreach (var parada in _hoja.Paradas.OrderBy(p => p.Orden))
        {
            var accion = UltimaAccion(parada);
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@parada.Orden. @parada.Destinatario</strong>
                    <EstadoParada Parada="parada" Accion="accion" />
                </div>
                <div>@parada.Direccion</div>
                <div class="small text-muted">Ventana @parada.VentanaDesde.ToLocalTime().ToString("HH:mm")–@parada.VentanaHasta.ToLocalTime().ToString("HH:mm")</div>
                @if (parada.Bultos is { Count: > 0 } bultos)
                {
                    <div class="small text-muted">Bultos · @string.Join(", ", bultos.Select(bulto => bulto.Codigo))</div>
                }
                @if (parada.AdmiteRegistro && accion is null or { Estado: EstadoAccion.Rechazada })
                {
                    <a class="btn btn-sm btn-primary mt-2" href="parada/@parada.EnvioId">Registrar visita</a>
                }
            </li>
        }
    </ul>
}

@code {
    private SesionRepartidor? _sesion;
    private HojaDeRutaDto? _hoja;
    private IReadOnlyList<AccionPendiente> _cola = [];
    private string? _mensaje;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        _sesion = await Datos.ObtenerSesionAsync();
        if (_sesion is null)
        {
            Navegacion.NavigateTo("login");
            return;
        }

        Cola.Cambio += AlCambiar;
        Conexion.Cambio += AlCambiar;
        Datos.HojaActualizada += AlCambiar;
        Datos.SesionActualizada += AlCambiar;
        await CargarAsync();
    }

    // Todo se lee del dispositivo: funciona igual con o sin conexión.
    private async Task CargarAsync()
    {
        _sesion = await Datos.ObtenerSesionAsync();
        _hoja = await Datos.ObtenerHojaAsync();
        _cola = _sesion is null ? [] : await Cola.ListarAsync(_sesion.RepartidorId);
    }

    private void AlCambiar() => _ = InvokeAsync(async () =>
    {
        await CargarAsync();
        StateHasChanged();
    });

    private AccionPendiente? UltimaAccion(ParadaDto parada) =>
        _cola.Where(a => a.Accion.CorrespondeA(parada.EnvioId, parada.ParadaId)).MaxBy(a => a.Accion.OcurridoEn);

    private Task ActualizarAsync() => DescargarAsync(_hoja?.RutaId);

    private Task CambiarRutaAsync(Guid rutaId) => DescargarAsync(rutaId);

    private async Task DescargarAsync(Guid? rutaId)
    {
        if (_sesion is not { } sesion) return;
        _mensaje = null;
        _procesando = true;
        try
        {
            await Datos.GuardarHojaAsync(sesion, await Api.ObtenerHojaDeRutaAsync(sesion, rutaId));
            await CargarAsync();
        }
        catch (SesionExpiradaException)
        {
            await Datos.MarcarSesionVencidaAsync(sesion);
            await CargarAsync();
        }
        catch (HttpRequestException)
        {
            _mensaje = "No se pudo descargar la hoja de ruta. Se sigue mostrando la guardada.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task SalirAsync()
    {
        // Cerrar sesión con acciones sin enviar las perdería: se bloquea.
        if (_cola.Any(a => a.Estado == EstadoAccion.Pendiente))
        {
            _mensaje = "Tenés acciones sin sincronizar. Conectate y esperá a que se envíen antes de salir.";
            return;
        }

        await Datos.CerrarSesionAsync();
        Navegacion.NavigateTo("login");
    }

    public void Dispose()
    {
        Cola.Cambio -= AlCambiar;
        Conexion.Cambio -= AlCambiar;
        Datos.HojaActualizada -= AlCambiar;
        Datos.SesionActualizada -= AlCambiar;
    }
}
