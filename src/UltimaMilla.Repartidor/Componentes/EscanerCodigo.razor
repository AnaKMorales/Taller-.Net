@* Escaneo de códigos con la cámara del celular (BarcodeDetector, sin conexión). Si el navegador no lo soporta, el
   botón no aparece y queda el ingreso manual o un lector externo. Cada código leído se avisa con AlLeer. *@
@implements IAsyncDisposable
@inject Navegador Dispositivo

@if (_disponible)
{
    <div class="mb-2">
        @if (_activo)
        {
            <video @ref="_video" class="w-100 rounded border" style="max-height: 16rem; object-fit: cover" muted></video>
            <button class="btn btn-sm btn-outline-secondary mt-1" type="button" @onclick="DetenerAsync">Cerrar cámara</button>
        }
        else
        {
            <button class="btn btn-outline-primary" type="button" disabled="@Deshabilitado" @onclick="Iniciar">Escanear con la cámara</button>
        }
        @if (_error is not null)
        {
            <div class="text-danger small mt-1" role="alert">@_error</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public EventCallback<string> AlLeer { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }

    private ElementReference _video;
    private DotNetObjectReference<EscanerCodigo>? _receptor;
    private bool _disponible, _activo, _iniciar;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _disponible = await Dispositivo.EscanerDisponibleAsync(); }
        catch (JSException) { _disponible = false; }
    }

    private void Iniciar()
    {
        _error = null;
        _activo = true;
        _iniciar = true; // el <video> recién existe después de renderizar
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_iniciar) return;
        _iniciar = false;
        _receptor ??= DotNetObjectReference.Create(this);
        string? motivo;
        try { motivo = await Dispositivo.IniciarEscaneoAsync(_video, _receptor); }
        catch (JSException) { motivo = "camara"; }
        if (motivo is null) return;
        _activo = false;
        _error = LecturaCodigo.MotivoSinCamara(motivo);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CodigoLeido(string codigo) => await InvokeAsync(() => AlLeer.InvokeAsync(codigo));

    private async Task DetenerAsync()
    {
        _activo = false;
        try { await Dispositivo.DetenerEscaneoAsync(); } catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        // Al salir de la pantalla se apaga la cámara.
        try { if (_activo) await Dispositivo.DetenerEscaneoAsync(); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        _receptor?.Dispose();
    }
}
