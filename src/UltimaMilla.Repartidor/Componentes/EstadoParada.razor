@* Muestra el estado del servidor o, si hay una acción local más reciente, el de esa acción. *@
@if (Accion is { Estado: EstadoAccion.Pendiente })
{
    <span class="badge bg-warning text-dark">@Texto(Accion.Accion.Resultado) · sin sincronizar</span>
}
else if (Accion is { Estado: EstadoAccion.Sincronizada } && Parada.Estado == EstadoEnvio.EnTransito)
{
    <span class="badge bg-success">@Texto(Accion.Accion.Resultado) · sincronizada</span>
}
else if (Accion is { Estado: EstadoAccion.Rechazada } && Parada.Estado == EstadoEnvio.EnTransito)
{
    <span class="badge bg-danger">Rechazada</span>
}
else
{
    <span class="badge @(Parada.Estado == EstadoEnvio.EnTransito ? "bg-primary" : "bg-secondary")">@Parada.Estado</span>
}

@code {
    [Parameter, EditorRequired] public ParadaDto Parada { get; set; } = null!;
    [Parameter] public AccionPendiente? Accion { get; set; }

    private static string Texto(ResultadoIntento resultado) =>
        resultado == ResultadoIntento.Entregado ? "Entregado" : "No entregado";
}
