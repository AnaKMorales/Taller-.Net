@implements IDisposable
@inject EstadoConexion Conexion
@inject ColaAcciones Cola
@inject SincronizacionAutomatica Automatica
@inject DatosLocales Datos
@inject TimeProvider Reloj

@* Indicador siempre visible: en línea / sin conexión y cuántas acciones faltan sincronizar. *@
<a href="pendientes" class="estado text-decoration-none small">
    @if (Conexion.EnLinea)
    {
        <span class="badge bg-success">● En línea</span>
    }
    else
    {
        <span class="badge bg-secondary">● Sin conexión</span>
    }
    @if (_pendientes > 0)
    {
        <span class="badge bg-warning text-dark ms-1">@_pendientes pendiente@(_pendientes == 1 ? "" : "s")</span>
    }
    @if (_sesionVencida)
    {
        <span class="badge bg-danger ms-1">Sesión vencida</span>
    }
    @if (_rechazadas > 0)
    {
        <span class="badge bg-danger ms-1">@_rechazadas rechazada@(_rechazadas == 1 ? "" : "s")</span>
    }
</a>

@code {
    private int _pendientes;
    private int _rechazadas;
    private bool _sesionVencida;

    protected override async Task OnInitializedAsync()
    {
        Conexion.Cambio += AlCambiar;
        Cola.Cambio += AlCambiar;
        Datos.SesionActualizada += AlCambiar;
        await ContarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El JavaScript está disponible recién después del primer renderizado.
        if (firstRender) await Automatica.IniciarAsync();
    }

    private void AlCambiar() => _ = InvokeAsync(async () =>
    {
        await ContarAsync();
        StateHasChanged();
    });

    private async Task ContarAsync()
    {
        var cola = await Cola.ListarAsync();
        _pendientes = cola.Count(a => a.Estado == EstadoAccion.Pendiente);
        _rechazadas = cola.Count(a => a.Estado == EstadoAccion.Rechazada);
        _sesionVencida = (await Datos.ObtenerSesionAsync())?.Vencida(Reloj.GetUtcNow()) == true;
    }

    public void Dispose()
    {
        Conexion.Cambio -= AlCambiar;
        Cola.Cambio -= AlCambiar;
        Datos.SesionActualizada -= AlCambiar;
    }
}
