#!/bin/bash
# Arranque de la instancia: instala Docker y la AWS CLI y deja lista la carpeta de despliegue.
# El despliegue en si lo hace el pipeline por SSM Run Command (deploy/aws/desplegar.sh, bajado de S3).
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl unzip

# Docker Engine y el plugin de Compose desde el repositorio oficial de Docker.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# AWS CLI v2 (login a ECR, parametros de SSM y archivos de S3).
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

# Datos de esta instancia que usa desplegar.sh (nada secreto: los secretos se bajan de SSM al desplegar).
install -d -m 0755 /opt/ultimamilla/deploy
cat > /etc/ultimamilla.env <<CONF
AWS_REGION=${region}
AWS_DEFAULT_REGION=${region}
AMBIENTE=${ambiente}
BUCKET_DESPLIEGUE=${bucket}
REGISTRO_ECR=${registro}
RUTA_SSM=${ruta_ssm}
CONF
chmod 0644 /etc/ultimamilla.env
