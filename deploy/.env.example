#POSTGRES
POSTGRES_DB=ultimamilla
POSTGRES_USER=ultimamilla
POSTGRES_PORT=55432
POSTGRES_PASSWORD=

#RABITMQ
RABBITMQ_PASSWORD=

# Grafana (tablero técnico, usuario admin): http://localhost:8000/grafana/ en local; en AWS la genera Terraform en SSM
GRAFANA_ADMIN_PASSWORD=


#WEB (opcionales)
#WEB_PORT=8080
#WEB_ENTORNO=          (Production por defecto; Development SOLO para la demo de webhooks)
#WEB_IMAGE=            (imagen de ECR; sin valor se construye ultimamilla-web:local)

#MIGRADOR (opcional)
#MIGRADOR_IMAGE=       (imagen de ECR; sin valor se construye ultimamilla-migrador:local)

#WORKER
#WEBHOOKS_PERMITIR_DESTINOS_PRIVADOS=   (false por defecto; true SOLO para la demo de webhooks)

#DEMO DE WEBHOOKS (opcionales)
#WEBHOOK_SECRETO=secreto-demo
#RECEPTOR_PORT=58080

#RED INTERNA (CIDR de la red de compose; Web confia en X-Forwarded-* solo desde ahi; defecto 172.28.0.0/16)
RED_INTERNA_SUBNET=

#TRAEFIK / DOMINIO (local: http://localhost:8000; en AWS los baja desplegar.sh de SSM Parameter Store)
#DOMINIO=               (localhost por defecto; en AWS, el dominio propio)
#TRAEFIK_HTTP_PORT=8000 (local; en AWS compose.aws.yaml publica 80 y 443)
#ACME_EMAIL=            (solo AWS: correo para Let's Encrypt)
#ACME_CA_SERVER=        (solo AWS: https://acme-staging-v02.api.letsencrypt.org/directory para probar sin gastar cuota)

#IMAGENES PROPIAS (opcionales; en AWS las pone desplegar.sh con el SHA del commit)
#WORKER_IMAGE=
#RECEPTOR_IMAGE=
