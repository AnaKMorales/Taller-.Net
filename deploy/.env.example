#POSTGRES
POSTGRES_DB=ultimamilla
POSTGRES_USER=ultimamilla
POSTGRES_PORT=55432
POSTGRES_PASSWORD=

#RABITMQ
RABBITMQ_PASSWORD=


#WEB (opcionales)
#WEB_PORT=8080
#WEB_ENTORNO=          (Production por defecto; Development SOLO para la demo de webhooks)
#WEB_IMAGE=            (imagen de ECR; sin valor se construye ultimamilla-web:local)

#MIGRADOR (opcional)
#MIGRADOR_IMAGE=       (imagen de ECR; sin valor se construye ultimamilla-migrador:local)

#WORKER
#WEBHOOKS_PERMITIR_DESTINOS_PRIVADOS=   (false por defecto; true SOLO para la demo de webhooks)

#DEMO DE WEBHOOKS (opcionales)
#WEBHOOK_SECRETO=secreto-demo
#RECEPTOR_PORT=58080

#RED INTERNA (CIDR de la red de compose; Web confia en X-Forwarded-* solo desde ahi; defecto 172.28.0.0/16)
RED_INTERNA_SUBNET=
